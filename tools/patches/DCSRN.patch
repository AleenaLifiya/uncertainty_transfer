+def _batch_norm_contrib(in_node, epsilon=1e-3):
+    """IR3C_more_comparisons B2 -- drop-in for the removed contrib batch-norm call.
+
+    `layers.batch_norm(inputs, decay)` with decay=0 and the default is_training=True
+    normalises by the CURRENT MINI-BATCH moments (the moving averages are overwritten every
+    step and never used), with center=True (trainable beta), scale=False (no gamma) and
+    epsilon=1e-3. That contrib module does not exist in TensorFlow 2, so the same
+    computation is written with core ops: same normalisation, same trainable parameters.
+    """
+    axes = list(range(len(in_node.get_shape()) - 1))
+    mean, variance = tf.nn.moments(in_node, axes=axes, keep_dims=True)
+    c = int(in_node.get_shape()[-1])
+    beta = tf.Variable(tf.zeros([c]), name='beta')
+    return tf.nn.batch_normalization(in_node, mean, variance, beta, None, epsilon)
